{
  "name": "axilo-integration-tests",
  "version": "0.1.0",
  "description": "End-to-end integration tests for AXILO",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "lint": "eslint tests --ext .ts",
    "lint:fix": "eslint tests --ext .ts --fix"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
  }
}
